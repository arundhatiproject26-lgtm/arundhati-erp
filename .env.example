# Postgres connection string. Apply sql/schema.sql to this database first.
DATABASE_URL=postgres://user:password@host:5432/arundhati
# Set to "false" for a local Postgres without TLS.
DATABASE_SSL=true

# AWS Cognito user pool (app client: USER_PASSWORD_AUTH enabled, no client secret).
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_REGION=ap-south-1
# Server-side admin calls (HR "create login") use the default AWS credential chain:
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, or an instance role.
